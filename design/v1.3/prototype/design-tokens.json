{
  "schema": "zodo.visual-tokens/1.3",
  "direction": "clear-day",
  "status": "implementation baseline derived from selected images; validate accessibility and font metrics in Flutter",
  "color": {
    "canvas": "#F7F8F6",
    "surface": "#FFFFFF",
    "ink": "#14202B",
    "textSecondary": "#5F6B78",
    "accent": "#157E78",
    "accentHover": "#106B66",
    "accentSoft": "#E2EFEC",
    "divider": "#DFE6E5",
    "fixedEvent": "#E4EFF9",
    "proposal": "#DFF0EB",
    "warningSurface": "#FFF0D6",
    "warningInk": "#845210",
    "error": "#B42318"
  },
  "typography": {
    "family": "platform Chinese sans serif",
    "fallbacks": [
      "Microsoft YaHei",
      "Noto Sans SC",
      "PingFang SC",
      "sans-serif"
    ],
    "body": 15,
    "secondary": 13,
    "section": 20,
    "pageTitle": 32,
    "lineHeight": 1.5,
    "codeOnlyInDiagnostics": true
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "radius": {
    "input": 10,
    "button": 10,
    "surface": 12
  },
  "layout": {
    "desktopReference": [
      1440,
      1024
    ],
    "mobileReference": [
      390,
      844
    ],
    "wideMin": 1200,
    "mediumMin": 800,
    "sidebarReference": 208,
    "detailReference": 380,
    "mobileMinTouchTarget": 48,
    "mainNav": [
      "今天",
      "收集箱",
      "目标",
      "日程",
      "回顾"
    ]
  },
  "motion": {
    "shortMs": 140,
    "normalMs": 220,
    "respectReducedMotion": true
  },
  "accessibility": {
    "textScaleTarget": 2.0,
    "useStatusTextBeyondColor": true,
    "focusVisible": true,
    "calendarHasAgendaEquivalent": true
  },
  "note": "尺寸为Flutter逻辑像素与实施起点，不是对每张生成图片的逐像素测量；字体不随包分发。",
  "role": "visual reference for Harness plugin and later Flutter",
  "host_scoping": {
    "apply_only_to_zodo_plugin": true,
    "respect_host_slots_and_theme": true,
    "do_not_replace_global_navigation": true,
    "mobile_bottom_navigation_phase": "later Flutter"
  }
}
